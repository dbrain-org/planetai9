# Copy to infra/.env.prod and fill in. Never commit the real file.

# Public site URL (used for CORS, canonical links, sitemap, RSS)
SITE_URL=https://planetai9.com

# Postgres password (choose a strong value)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional — enriches PlanetAI9 videos (views, exact dates). Scraping works without it.
YOUTUBE_API_KEY=

# Secret for the /yonetim moderation panel (marketplace approvals). Pick a long random value.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Per-author keys for the /yazar writer studio. Format: "slug:secret,slug2:secret2".
# Unset ⇒ /yazar is disabled. e.g. ayhan-demirci:pick-a-long-random-string
AUTHOR_KEYS=

# Author slugs (comma list) allowed to moderate the AI Marketplace queue from /yazar.
# e.g. MODERATOR_AUTHORS=ayhan-demirci
MODERATOR_AUTHORS=

# --- TLS / reverse proxy -----------------------------------------------------
# `web` binds to 127.0.0.1:${WEB_PORT} only. Put a proxy in front:
#   - your own (Nginx/Traefik/…) → forward to that port, or
#   - the bundled Caddy: set SITE_DOMAIN and run with `--profile caddy`
WEB_PORT=3000
SITE_DOMAIN=planetai9.com

# --- error monitoring (optional) -------------------------------------------
# Sentry DSNs. Unset ⇒ Sentry disabled everywhere.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- database backups --------------------------------------------------------
# Daily pg_dump into the `pgbackups` volume (prodrigestivill/postgres-backup-local).
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Off-site copies (S3 / Backblaze B2 / Cloudflare R2 / MinIO).
# Run with `--profile offsite` once these are set. AWS_ENDPOINT is host only
# (no https://); leave blank for AWS S3.
OFFSITE_CRON=30 3 * * *
OFFSITE_RETENTION_DAYS=30
OFFSITE_S3_BUCKET=
OFFSITE_S3_PATH=planetai-backups
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_ENDPOINT=

# LLM Radar — Türkiye LLM vitrin KPIs / model rows (falls back if unset/down)
PLANETAI_LLMRADAR_API_BASE=https://llmradar.planetai9.com
PLANETAI_LLMRADAR_WEB_BASE=https://llmradar.planetai9.com
PLANETAI_CACHE_TTL_TURKIYE_LLM_SEC=600
