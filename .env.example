# Copy to .env and fill in. Consumed by planetai_shared.settings (prefix PLANETAI_).
PLANETAI_DATABASE_URL=postgresql+psycopg://planetai:planetai@localhost:5442/planetai
PLANETAI_REDIS_URL=redis://localhost:6379/0

# YouTube Data API v3 — required for the PlanetAI video collector
PLANETAI_YOUTUBE_API_KEY=
PLANETAI_YOUTUBE_CHANNEL_ID=

PLANETAI_AI_ENRICH_ENABLED=false

# Secret for the /yonetim marketplace moderation panel. Unset ⇒ panel returns 404.
PLANETAI_ADMIN_TOKEN=

# Per-author keys for the /yazar writer studio (köşe yazıları).
# Format: "slug:secret,slug2:secret2". Unset ⇒ /yazar returns 404.
# e.g. PLANETAI_AUTHOR_KEYS=ayhan-demirci:pick-a-long-random-string
PLANETAI_AUTHOR_KEYS=

# Author slugs allowed to approve/reject AI Marketplace submissions from /yazar.
# e.g. PLANETAI_MODERATOR_AUTHORS=ayhan-demirci
PLANETAI_MODERATOR_AUTHORS=

# Error monitoring (optional) — unset means Sentry is disabled.
PLANETAI_SENTRY_DSN=
PLANETAI_SENTRY_TRACES_SAMPLE_RATE=0

# LLM Radar (Türkiye LLM vitrin). Unset ⇒ overview falls back to curated + news.
PLANETAI_LLMRADAR_API_BASE=https://llmradar.planetai9.com
PLANETAI_LLMRADAR_WEB_BASE=https://llmradar.planetai9.com
PLANETAI_CACHE_TTL_TURKIYE_LLM_SEC=600
